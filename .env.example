# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional server-only Firebase Service Account JSON string
# for direct firebase-admin Firestore SDK access without user bearer delegation.
# Never prefix server secrets with VITE_.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Cloudflare R2 Storage Configuration
CLOUDFLARE_R2_ACCOUNT_ID="your_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="tests"
CLOUDFLARE_R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-<hash>.r2.dev"
VITE_CLOUDFLARE_R2_PUBLIC_URL="https://pub-<hash>.r2.dev"
