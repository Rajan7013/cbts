rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /test-media/{allPaths=**} {
      // Allow public read so test takers and preview can display question diagrams
      allow read: if true;
      // Allow write if user is signed in
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
